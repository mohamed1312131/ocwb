# Copy this file to .env and replace the placeholder values.
PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/omnicaredb
SPRING_DATASOURCE_USERNAME=your_postgres_username
SPRING_DATASOURCE_PASSWORD=your_postgres_password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# These values create the first admin account when its email does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=OmniCare

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary Console > API Keys. Never expose this value in the frontend.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# The QR code points here. Use the deployed backend URL in production.
SHARE_REDIRECT_BASE_URL=http://localhost:8080
